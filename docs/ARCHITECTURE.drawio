        <mxCell id="l2_label" value="LAYER 2 — Content Critics (src/isnad/critics/) — measured, not estimated" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#28a745;" vertex="1" parent="1">
          <mxGeometry x="55" y="633" width="420" height="20" as="geometry" />
        </mxCell>

        <mxCell id="critic_llm" value="&lt;b&gt;LLMCritic&lt;/b&gt; — 1.000 recall / 0.000 false-consistent&lt;br&gt;Provider-agnostic: DeepSeek · OpenRouter · OpenAI · Anthropic&lt;br&gt;Gemini · Groq · Together · Ollama (local, no key)&lt;br&gt;best_available_critic() prefers this by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="380" height="90" as="geometry" />
        </mxCell>

        <mxCell id="critic_nli" value="&lt;b&gt;LocalNLICritic / HybridCritic&lt;/b&gt;&lt;br&gt;Fixed (#110): label order, softmax, retrieval, contradiction-first&lt;br&gt;LocalNLI 0.760 recall / 0.000 false-consistent&lt;br&gt;Hybrid 0.720 / 0.040" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="460" y="660" width="380" height="90" as="geometry" />
        </mxCell>

        <mxCell id="critic_embed" value="&lt;b&gt;EmbeddingCritic&lt;/b&gt; (TF-IDF)&lt;br&gt;0.120 recall / 0.320 false-consistent&lt;br&gt;Safest zero-dependency option, low recall&lt;br&gt;TFIDFIndex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="860" y="660" width="350" height="90" as="geometry" />
        </mxCell>

        <mxCell id="critic_eval" value="&lt;b&gt;eval.py + experiments/critic_eval/&lt;/b&gt;&lt;br&gt;Committed 60-case labeled eval set&lt;br&gt;Runner writes RESULTS.md + results.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
