        <mxCell id="l0_label" value="LAYER 0 — Types &amp; Enums (src/isnad/types.py)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
