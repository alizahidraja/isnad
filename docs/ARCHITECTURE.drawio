        <mxCell id="l1_label" value="LAYER 1 — Core Engine (src/isnad/core/)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0077b6;" vertex="1" parent="1">
          <mxGeometry x="55" y="283" width="300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="chain_box" value="&lt;b&gt;chain.py&lt;/b&gt;&lt;br&gt;🔗 ChainLinkSpec · Chain&lt;br&gt;   .is_complete → ittiṣāl (gap → DAIF)&lt;br&gt;   .narrator_ids, .to_jsonb()&lt;br&gt;🔗 store_claim() · get_chain_from_db()&lt;br&gt;🔗 make_claim_id() — SHA-256&lt;br&gt;🔗 grades_for_chain() · adalah_grades_for_chain()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="290" height="140" as="geometry" />
        </mxCell>

        <mxCell id="reg_box" value="&lt;b&gt;registry.py&lt;/b&gt;&lt;br&gt;📋 Registry (in-memory) · RegistryDB (SQLAlchemy)&lt;br&gt;📋 register() · get_grade() · record_evidence()&lt;br&gt;📋 seed() · seed_from_benchmark() · accuracy_to_grade()&lt;br&gt;📋 quarantine() · bump_version() · dispute()/adjudicate()&lt;br&gt;📋 get_grade_as_of() — period-sliced (ikhtilāṭ)&lt;br&gt;📋 record_survival() · evidence_provenance() · renew_grade()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="370" y="310" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="policies_box" value="&lt;b&gt;policies.py&lt;/b&gt;&lt;br&gt;⚙️ BayesianTransitionPolicy (DEFAULT, Beta posterior)&lt;br&gt;⚙️ ThresholdTransitionPolicy · CalibratedThresholdPolicy&lt;br&gt;⚙️ Integrity strikes-per-tier ladder (ʿadālah permanent)&lt;br&gt;⚙️ Precision recoverable; REJECTED sticky only if COMPROMISED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="690" y="310" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="grading_box" value="&lt;b&gt;grading.py&lt;/b&gt;&lt;br&gt;⚖️ RefinedWeakestLink (default)&lt;br&gt;   DESTRUCTIVE → hard floor&lt;br&gt;   GENERATIVE → repair (corroboration-gated)&lt;br&gt;   Incomplete → DAIF · REJECTED → MAWDU&lt;br&gt;⚖️ fidelity verdicts cap a contradicted link&lt;br&gt;⚖️ grade_chain() convenience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1010" y="310" width="290" height="140" as="geometry" />
        </mxCell>

        <mxCell id="corr_box" value="&lt;b&gt;corroboration.py&lt;/b&gt;&lt;br&gt;🔄 SharedLineageDetector — madār detection&lt;br&gt;   shared IDs (0.0) · family (−0.4) · source (−0.3)&lt;br&gt;   UNKNOWN_LINEAGE_SCORE (0.5) — independence must be attested (#83)&lt;br&gt;🔄 CappedCorroborationPolicy — capped at HASAN&lt;br&gt;🔄 CorroborationEngine · evaluate_corroboration()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="340" height="130" as="geometry" />
        </mxCell>

        <mxCell id="decision_box" value="&lt;b&gt;decision.py — 4×3 matrix&lt;/b&gt;&lt;br&gt;🎯 decide(chain_grade, content_verdict) → Action&lt;br&gt;   SAHIH/HASAN/DAIF/MAWDU × CONSISTENT/CONTRADICTION/UNVERIFIABLE&lt;br&gt;   SERVE · SERVE_WITH_CAVEAT · REVIEW · QUARANTINE · REJECT_AND_QUARANTINE_NARRATOR&lt;br&gt;🎯 describe_action() — human-readable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="identity_box" value="&lt;b&gt;identity.py · fidelity.py · volatility.py&lt;/b&gt;&lt;br&gt;🔑 alias@version resolution (endpoint drift)&lt;br&gt;🔑 compute_fidelity_verdicts() — per-link I/O snapshots&lt;br&gt;🔑 FixedVolatilityPolicy — grade TTL / stale / expired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="740" y="470" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="storage_box" value="&lt;b&gt;storage/ · matn.py&lt;/b&gt;&lt;br&gt;💾 RegistryPersistence protocol · SQLAlchemy sessions&lt;br&gt;📝 DeterministicRuleCritic — reference stub (offline demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1060" y="470" width="240" height="130" as="geometry" />
