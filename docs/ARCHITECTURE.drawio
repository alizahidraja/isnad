        <mxCell id="l1_label" value="LAYER 1 — Core Engine (src/isnad/core/)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0077b6;" vertex="1" parent="1">
          <mxGeometry x="55" y="288" width="300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="chain_box" value="&lt;b&gt;chain.py — Transmission Chain&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔗 &lt;b&gt;ChainLinkSpec&lt;/b&gt;: narrator_id, step, version,&lt;br&gt;   transform_type, trace_id, domain, confidence&lt;br&gt;🔗 &lt;b&gt;Chain&lt;/b&gt;: ordered links, gap-checked&lt;br&gt;   .is_complete → ittiṣāl&lt;br&gt;   .chain_status → COMPLETE | MUNQATI&lt;br&gt;   .narrator_ids → ordered list&lt;br&gt;   .to_jsonb() → serialization&lt;br&gt;🔗 &lt;b&gt;store_claim()&lt;/b&gt; → RijalClaim ORM&lt;br&gt;🔗 &lt;b&gt;make_claim_id()&lt;/b&gt; → SHA-256&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#28a745&quot;&gt;✅ 10 tests pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="290" height="155" as="geometry" />
        </mxCell>

        <mxCell id="reg_box" value="&lt;b&gt;registry.py — Rijāl Registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;📋 &lt;b&gt;Narrator&lt;/b&gt;: (id, domain) keyed, evidence_log&lt;br&gt;📋 &lt;b&gt;Registry&lt;/b&gt;: in-memory store&lt;br&gt;   .register(), .get_grade(), .get_metadata()&lt;br&gt;   .record_evidence() → jarḥ–taʿdīl state machine&lt;br&gt;   .quarantine(), .bump_version()&lt;br&gt;📋 &lt;b&gt;RegistryDB&lt;/b&gt;: SQLAlchemy-backed&lt;br&gt;   .load(), .flush()&lt;br&gt;📋 &lt;b&gt;TransitionPolicies&lt;/b&gt;:&lt;br&gt;   BayesianTransitionPolicy (DEFAULT)&lt;br&gt;   ThresholdTransitionPolicy (fallback)&lt;br&gt;   CalibratedThresholdPolicy&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#28a745&quot;&gt;✅ Bayesian default | 21 tests pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="370" y="315" width="290" height="180" as="geometry" />
        </mxCell>

        <mxCell id="grading_box" value="&lt;b&gt;grading.py — Chain Grading&lt;/b&gt;&lt;br&gt;&lt;br&gt;⚖️ &lt;b&gt;RefinedWeakestLink&lt;/b&gt; (default)&lt;br&gt;   Walks chain step-by-step:&lt;br&gt;   → DESTRUCTIVE: permanent hard floor&lt;br&gt;   → GENERATIVE: can repair (corroboration-gated)&lt;br&gt;   → PASS_THROUGH: standard min&lt;br&gt;   → Incomplete chain → DAIF cap&lt;br&gt;⚖️ &lt;b&gt;grade_chain()&lt;/b&gt; convenience&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#28a745&quot;&gt;✅ 17 tests pass | Pluggable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="680" y="315" width="270" height="155" as="geometry" />
        </mxCell>

        <mxCell id="corr_box" value="&lt;b&gt;corroboration.py — Mutābaʿāt&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔄 &lt;b&gt;SharedLineageDetector&lt;/b&gt;&lt;br&gt;   .are_independent() — madār detection&lt;br&gt;   .compute_independence_score()&lt;br&gt;   Penalties: shared IDs (0.0), family (-0.4), source (-0.3)&lt;br&gt;🔄 &lt;b&gt;CappedCorroborationPolicy&lt;/b&gt;&lt;br&gt;   Info-theoretic error multiplication&lt;br&gt;   ERROR_PROBS: SAHIH=0.01, HASAN=0.10, DAIF=0.30, MAWDU=0.90&lt;br&gt;   MIN_EFFECTIVE_WEIGHT = 2.0 (configurable)&lt;br&gt;🔄 &lt;b&gt;CorroborationEngine&lt;/b&gt;&lt;br&gt;   .evaluate() — exact text matching&lt;br&gt;   .evaluate_direct() — pre-matched chains&lt;br&gt;   _evaluate_core() — shared logic&lt;br&gt;   _compute_effective_weight() — log-error ratio&lt;br&gt;🔄 &lt;b&gt;evaluate_corroboration()&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#28a745&quot;&gt;✅ Empirically validated (707 pairs, 100%)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#28a745&quot;&gt;✅ 8/8 negative controls | 15 tests pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="970" y="315" width="340" height="215" as="geometry" />
        </mxCell>

        <mxCell id="decision_box" value="&lt;b&gt;decision.py — Decision Matrix&lt;/b&gt;&lt;br&gt;&lt;br&gt;🎯 &lt;b&gt;decide(chain_grade, content_verdict)&lt;/b&gt;&lt;br&gt;   4×2 matrix → Action enum&lt;br&gt;   SERVE | SERVE_WITH_CAVEAT | REVIEW&lt;br&gt;   QUARANTINE | REJECT_AND_QUARANTINE&lt;br&gt;🎯 &lt;b&gt;describe_action()&lt;/b&gt; — human-readable&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#28a745&quot;&gt;✅ All 12 cells tested&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0077b6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="505" width="290" height="100" as="geometry" />
        </mxCell>

        <mxCell id="matn_box" value="&lt;b&gt;matn.py — Content Criticism&lt;/b&gt;&lt;br&gt;&lt;br&gt;📝 &lt;b&gt;DeterministicRuleCritic&lt;/b&gt;&lt;br&gt;   REFERENCE STUB — 8 hardcoded patterns&lt;br&gt;   .add_pattern(), .evaluate()&lt;br&gt;&lt;font color=&quot;#ffc107&quot;&gt;⚠️ STUB — limited pattern coverage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#ffc107;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="680" y="505" width="270" height="100" as="geometry" />
