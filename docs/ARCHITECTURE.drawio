  <diagram id="validation" name="3. Validation Matrix">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="vtitle" value="Validation Status — What's Measured vs What's Not (as of August 2026)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="800" height="35" as="geometry" />
        </mxCell>

        <mxCell id="pv_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1320" height="330" as="geometry" />
        </mxCell>
        <mxCell id="pv_label" value="✅ MEASURED / VALIDATED" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;fontColor=#155724;" vertex="1" parent="1">
          <mxGeometry x="55" y="75" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="pv1" value="&lt;b&gt;Content critics — measured&lt;/b&gt;&lt;br&gt;LLM (DeepSeek): 1.000 recall / 0.000 false-consistent&lt;br&gt;LocalNLI: 0.760 / 0.000 · Hybrid: 0.720 / 0.040&lt;br&gt;Embedding: 0.120 / 0.320&lt;br&gt;60-case committed eval set (experiments/critic_eval/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="310" height="95" as="geometry" />
        </mxCell>
        <mxCell id="pv2" value="&lt;b&gt;Corroboration — validated&lt;/b&gt;&lt;br&gt;603/603 (Wikipedia) + 104/104 (physics) pairs&lt;br&gt;8/8 negative controls pass&lt;br&gt;Requires attested distinct lineage (madār, #83)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="390" y="110" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="pv3" value="&lt;b&gt;Weakest-link grading — validated&lt;/b&gt;&lt;br&gt;REJECTED → MAWDU → quarantine (100%)&lt;br&gt;Incomplete → DAIF cap · generative repair gated&lt;br&gt;ISNAD-Bench: κ=0.871 vs scholarly consensus&lt;br&gt;(human ceiling κ=0.33)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="710" y="110" width="310" height="95" as="geometry" />
        </mxCell>
        <mxCell id="pv4" value="&lt;b&gt;Cold-start seeding — evidence-backed&lt;/b&gt;&lt;br&gt;Registry.seed() survives the Bayesian posterior (#90/#114)&lt;br&gt;seed_from_benchmark() / accuracy_to_grade() — per-role&lt;br&gt;Coverage is critic-bound: LLM ~63% vs embedding ~56% (new claims)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1040" y="110" width="300" height="95" as="geometry" />
        </mxCell>

        <mxCell id="pv5" value="&lt;b&gt;Decision matrix (12 cells) · API endpoints · DB persistence · detached signatures (HMAC + Ed25519) · Merkle batch log · Live Verify integration · 738 tests · ruff/mypy clean&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#28a745;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="1280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="pp_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#ffc107;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="pp_label" value="⚠️ PARTIAL / REFERENCE — documented honestly" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;fontColor=#856404;" vertex="1" parent="1">
          <mxGeometry x="55" y="425" width="450" height="25" as="geometry" />
        </mxCell>

        <mxCell id="pp1" value="&lt;b&gt;Offline critics on new claims&lt;/b&gt;&lt;br&gt;NLI critics are safe but conservative — return UNVERIFIABLE&lt;br&gt;for most non-contradictions (correct under-trust bias),&lt;br&gt;so auto-serving needs the LLM tier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffc107;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pp2" value="&lt;b&gt;DeterministicRuleCritic&lt;/b&gt;&lt;br&gt;Reference stub — 8 hardcoded patterns, offline demo only.&lt;br&gt;The real serving critic is best_available_critic() (LLM-first)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffc107;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="480" y="460" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pp3" value="&lt;b&gt;Accuracy → grade bands&lt;/b&gt;&lt;br&gt;0.90/0.75/0.60 are reference defaults (documented).&lt;br&gt;Bayesian thresholds are likewise reference defaults.&lt;br&gt;Operator should calibrate per deployment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffc107;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="900" y="460" width="420" height="70" as="geometry" />
        </mxCell>

        <mxCell id="nd_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#dc3545;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nd_label" value="❌ OPEN / KNOWN LIMITS — tracked" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;fontColor=#721c24;" vertex="1" parent="1">
          <mxGeometry x="55" y="615" width="300" height="25" as="geometry" />
        </mxCell>

        <mxCell id="nd1" value="&lt;b&gt;Chain independence&lt;/b&gt; (#54)&lt;br&gt;Topology cannot prove independence — correlated&lt;br&gt;blind spots / content-level correlated error are&lt;br&gt;undetectable. Documented, not hidden." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc3545;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nd2" value="&lt;b&gt;Live Verify issuer revocation&lt;/b&gt; (#122)&lt;br&gt;revocation-on-regrade is unimplemented — a published&lt;br&gt;verdict stays &quot;verified&quot; forever, overstating currency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc3545;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="380" y="650" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nd3" value="&lt;b&gt;Human ground-truth validation&lt;/b&gt;&lt;br&gt;Claims verified by semantic overlap, not checked&lt;br&gt;against authoritative references — would strengthen §8." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc3545;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="650" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nd4" value="&lt;b&gt;Broader multi-source corpora&lt;/b&gt;&lt;br&gt;ArXiv / textbooks / news not yet exercised;&lt;br&gt;would strengthen independence claims." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc3545;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1020" y="650" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="tests_note" value="&lt;b&gt;Test suite:&lt;/b&gt; 738 tests (pytest) | &lt;b&gt;ruff + mypy:&lt;/b&gt; clean | &lt;b&gt;Version:&lt;/b&gt; 2.7.0 on PyPI | &lt;b&gt;Paper:&lt;/b&gt; arXiv:2607.24117" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="1260" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
