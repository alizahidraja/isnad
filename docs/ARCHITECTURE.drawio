        <mxCell id="grade_box" value="&lt;b&gt;Ordinal Grades&lt;/b&gt;&lt;br&gt;NarratorGrade (5 tiers)&lt;br&gt;ChainGrade (4 tiers)&lt;br&gt;AdalahGrade (5) · DabtGrade (4)&lt;br&gt;FreshnessStatus (3)&lt;br&gt;&lt;font color=&quot;#28a745&quot;&gt;✅ Ordered comparison | .min()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
