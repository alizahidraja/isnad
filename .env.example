# Environment variables for Isnād
# Copy to .env and fill in as needed

# Database URL (defaults to SQLite for quickstart)
ISNAD_DATABASE_URL=sqlite:///isnad.db

# --- API auth (fail-closed; no default credential, issue #93) ---
# Comma-separated `name:role` pairs. Authenticated endpoints return 503
# until this is set. Example: isnad-admin:admin,isnad-reader:reader
ISNAD_API_KEYS=

# --- CORS (opt-in; comma-separated allowlist) ---
ISNAD_CORS_ORIGINS=

# --- Docker Compose only ---
# POSTGRES_PASSWORD=   # required for `docker compose up`
# POSTGRES_PORT_PUBLISH=127.0.0.1:   # publish db/redis/prometheus to host (opt-in)

# --- LLM-backed content critic (optional; provider-agnostic) ---
# Set a provider + model, or just set one of the provider-specific keys below.
# ISNAD_LLM_PROVIDER disambiguates when several keys are present.
# See list_providers() for the full catalog.
ISNAD_LLM_PROVIDER=
ISNAD_LLM_MODEL=

# Provider-specific keys (set the one you use):
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=       # (GOOGLE_API_KEY also accepted)
GROQ_API_KEY=
TOGETHER_API_KEY=

# Generic custom endpoint (any OpenAI-compatible API):
ISNAD_LLM_BASE_URL=
ISNAD_LLM_API_KEY=
